table SalesTable
	lineageTag: 46aca378-7cff-4949-bee7-1f0dd07f0d84

	measure 'Total Revenue' = SUM('SalesTable'[Net_Sales])
		formatString: #,0.00\ "₫";-#,0.00\ "₫";#,0.00\ "₫"
		lineageTag: 4f6271dd-47ad-4f32-9927-14e90d3c5b8f

		annotation PBI_FormatHint = {"currencyCulture":"vi-VN"}

	measure 'Total Profit' =
			
			SUM('SalesTable'[Gross_Profit])
		formatString: #,0.00\ "₫";-#,0.00\ "₫";#,0.00\ "₫"
		lineageTag: 6c2144fa-102d-49e6-a7eb-72f17f87aa55

		annotation PBI_FormatHint = {"currencyCulture":"vi-VN"}

	measure 'Total Quantity' =
			
			SUM('SalesTable'[Quantity])
		formatString: 0
		lineageTag: 463f90c6-d1b0-46f0-94bf-e63964435601

	measure 'Profit Margin' =
			
			DIVIDE(
			    [Total Profit],
			    [Total Revenue],
			    0
			)
		formatString: #,0.00%;-#,0.00%;#,0.00%
		lineageTag: 4b8a7440-51cb-4924-bf07-82bdc9ec9dfd

	measure 'Previous Month Revenue' =
			
			CALCULATE(
			    [Total Revenue],
			    DATEADD('DateTable'[Date], -1, MONTH)
			)
		lineageTag: e4f3e57f-6985-453d-b0a3-127ee20f4ef5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'MoM Revenue Growth' =
			
			DIVIDE(
			    [Total Revenue] - [Previous Month Revenue],
			    [Previous Month Revenue]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 61435ab7-f0e5-42a0-be06-3e498e62ddb5

	measure 'Previous Month Profit' =
			
			CALCULATE(
			    [Total Profit],
			    DATEADD('DateTable'[Date], -1, MONTH)
			)
		lineageTag: a742a48b-42f6-4bd7-923b-d0947b770958

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'MoM Profit Growth' =
			
			DIVIDE(
			    [Total Profit] - [Previous Month Profit],
			    [Previous Month Profit]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9ff6bd69-2f0d-471c-95e7-ec7dd0f87946

	/// Change in Total Revenue versus the immediately preceding period of the same length (in months). Blank when no prior data exists.
	measure 'Revenue vs PP %' =
			VAR _first = MIN ( 'DateTable'[Date] )
			VAR _last = MAX ( 'DateTable'[Date] )
			VAR _months = DATEDIFF ( _first, _last, MONTH ) + 1
			VAR _prior =
			    CALCULATE (
			        [Total Revenue],
			        REMOVEFILTERS ( 'DateTable' ),
			        DATESBETWEEN ( 'DateTable'[Date], EDATE ( _first, - _months ), _first - 1 )
			    )
			VAR _current = [Total Revenue]
			RETURN
			    IF ( NOT ISBLANK ( _prior ), DIVIDE ( _current - _prior, _prior ) )
		formatString: \↑\ 0.00%;\↓\ 0.00%;0.00%
		displayFolder: Dashboard Design
		lineageTag: 0c8ff0d7-532d-4bec-8003-043af80e7719

	/// Change in Total Profit versus the immediately preceding period of the same length (in months). Blank when no prior data exists.
	measure 'Profit vs PP %' =
			VAR _first = MIN ( 'DateTable'[Date] )
			VAR _last = MAX ( 'DateTable'[Date] )
			VAR _months = DATEDIFF ( _first, _last, MONTH ) + 1
			VAR _prior =
			    CALCULATE (
			        [Total Profit],
			        REMOVEFILTERS ( 'DateTable' ),
			        DATESBETWEEN ( 'DateTable'[Date], EDATE ( _first, - _months ), _first - 1 )
			    )
			VAR _current = [Total Profit]
			RETURN
			    IF ( NOT ISBLANK ( _prior ), DIVIDE ( _current - _prior, _prior ) )
		formatString: \↑\ 0.00%;\↓\ 0.00%;0.00%
		displayFolder: Dashboard Design
		lineageTag: b0b79d7d-abbe-42d6-ba90-0f39581c51ae

	/// Change in Total Quantity versus the immediately preceding period of the same length (in months). Blank when no prior data exists.
	measure 'Quantity vs PP %' =
			VAR _first = MIN ( 'DateTable'[Date] )
			VAR _last = MAX ( 'DateTable'[Date] )
			VAR _months = DATEDIFF ( _first, _last, MONTH ) + 1
			VAR _prior =
			    CALCULATE (
			        [Total Quantity],
			        REMOVEFILTERS ( 'DateTable' ),
			        DATESBETWEEN ( 'DateTable'[Date], EDATE ( _first, - _months ), _first - 1 )
			    )
			VAR _current = [Total Quantity]
			RETURN
			    IF ( NOT ISBLANK ( _prior ), DIVIDE ( _current - _prior, _prior ) )
		formatString: \↑\ 0.00%;\↓\ 0.00%;0.00%
		displayFolder: Dashboard Design
		lineageTag: a0ae758f-12e6-450d-a042-8f7a854c2afd

	/// Change in Profit Margin versus the immediately preceding period of the same length, in percentage points. Blank when no prior data exists.
	measure 'Margin vs PP (pp)' =
			VAR _first = MIN ( 'DateTable'[Date] )
			VAR _last = MAX ( 'DateTable'[Date] )
			VAR _months = DATEDIFF ( _first, _last, MONTH ) + 1
			VAR _priorRevenue =
			    CALCULATE (
			        [Total Revenue],
			        REMOVEFILTERS ( 'DateTable' ),
			        DATESBETWEEN ( 'DateTable'[Date], EDATE ( _first, - _months ), _first - 1 )
			    )
			VAR _priorMargin =
			    CALCULATE (
			        [Profit Margin],
			        REMOVEFILTERS ( 'DateTable' ),
			        DATESBETWEEN ( 'DateTable'[Date], EDATE ( _first, - _months ), _first - 1 )
			    )
			RETURN
			    IF ( NOT ISBLANK ( _priorRevenue ), ( [Profit Margin] - _priorMargin ) * 100 )
		formatString: \↑\ 0.00\ \p\p;\↓\ 0.00\ \p\p;0.00\ \p\p
		displayFolder: Dashboard Design
		lineageTag: c65a6811-a5c0-4b41-98fd-16fede4c4153

	/// Font color for the revenue change label: green when up, red when down, grey when there is no prior period.
	measure 'Revenue Delta Color' =
			VAR _change = [Revenue vs PP %]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _change ), "#8A94A6", _change >= 0, "#16A34A", "#DC2626" )
		displayFolder: Dashboard Design
		lineageTag: 1d43f810-c8d7-4dbc-b0af-ff71aedb8631

	/// Font color for the profit change label: green when up, red when down, grey when there is no prior period.
	measure 'Profit Delta Color' =
			VAR _change = [Profit vs PP %]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _change ), "#8A94A6", _change >= 0, "#16A34A", "#DC2626" )
		displayFolder: Dashboard Design
		lineageTag: 8ad392a8-fb5e-4a5f-b483-4f687a0b68b9

	/// Font color for the quantity change label: green when up, red when down, grey when there is no prior period.
	measure 'Quantity Delta Color' =
			VAR _change = [Quantity vs PP %]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _change ), "#8A94A6", _change >= 0, "#16A34A", "#DC2626" )
		displayFolder: Dashboard Design
		lineageTag: 8d72151b-5c59-4d90-8494-593313c19a81

	/// Font color for the margin change label: green when up, red when down, grey when there is no prior period.
	measure 'Margin Delta Color' =
			VAR _change = [Margin vs PP (pp)]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _change ), "#8A94A6", _change >= 0, "#16A34A", "#DC2626" )
		displayFolder: Dashboard Design
		lineageTag: 4a84a4c7-5370-4d6f-95cd-6b2c1ff3713d

	/// First and last month of the current date selection, e.g. "Jan 2025 – Dec 2025", shown in the report header.
	measure 'Period Label' =
			VAR _first = MIN ( 'DateTable'[Date] )
			VAR _last = MAX ( 'DateTable'[Date] )
			RETURN
			    IF ( NOT ISBLANK ( _first ), FORMAT ( _first, "mmm yyyy" ) & " – " & FORMAT ( _last, "mmm yyyy" ) )
		displayFolder: Dashboard Design
		lineageTag: bbe34e8a-9517-4f32-86e8-6e6e8f64f8ab

	/// Key takeaway 1: total revenue and its change versus the previous period.
	measure 'Takeaway Revenue' =
			VAR _revenue = [Total Revenue]
			VAR _change = [Revenue vs PP %]
			VAR _revenueText =
			    IF (
			        _revenue >= 1e9,
			        FORMAT ( _revenue / 1e9, "0.00" ) & "B ₫",
			        FORMAT ( _revenue / 1e6, "0.00" ) & "M ₫"
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( _revenue ),
			        "Total revenue reached " & _revenueText
			            & IF (
			                ISBLANK ( _change ),
			                " across " & [Period Label] & ".",
			                ", " & IF ( _change >= 0, "up ", "down " ) & FORMAT ( ABS ( _change ), "0.00%" ) & " compared to the previous period."
			            )
			    )
		displayFolder: Dashboard Design
		lineageTag: 037a019f-94e6-426f-9693-5ba23d80fca7

	/// Key takeaway 2: overall profit margin and the month with the highest margin.
	measure 'Takeaway Margin' =
			VAR _months =
			    FILTER (
			        ADDCOLUMNS (
			            SUMMARIZE ( 'DateTable', 'DateTable'[Year], 'DateTable'[Month_Number] ),
			            "@Margin", [Profit Margin],
			            "@Revenue", [Total Revenue]
			        ),
			        [@Revenue] > 0
			    )
			VAR _peak = TOPN ( 1, _months, [@Margin], DESC )
			VAR _peakMargin = MAXX ( _peak, [@Margin] )
			VAR _peakMonth = MAXX ( _peak, FORMAT ( DATE ( 'DateTable'[Year], 'DateTable'[Month_Number], 1 ), "mmmm" ) )
			RETURN
			    IF (
			        COUNTROWS ( _months ) > 0,
			        "Profit margin held around " & FORMAT ( [Profit Margin], "0.0%" )
			            & ", with a peak of " & FORMAT ( _peakMargin, "0.00%" ) & " in " & _peakMonth & "."
			    )
		displayFolder: Dashboard Design
		lineageTag: 9626160a-3051-4704-9804-07841a36e455

	/// Key takeaway 3: how often revenue and profit growth moved together, and the month with the strongest revenue growth.
	measure 'Takeaway Growth' =
			VAR _months =
			    FILTER (
			        ADDCOLUMNS (
			            SUMMARIZE ( 'DateTable', 'DateTable'[Year], 'DateTable'[Month_Number] ),
			            "@RevenueGrowth", [MoM Revenue Growth],
			            "@ProfitGrowth", [MoM Profit Growth]
			        ),
			        NOT ISBLANK ( [@RevenueGrowth] ) && NOT ISBLANK ( [@ProfitGrowth] )
			    )
			VAR _monthCount = COUNTROWS ( _months )
			VAR _sameDirection = COUNTROWS ( FILTER ( _months, SIGN ( [@RevenueGrowth] ) = SIGN ( [@ProfitGrowth] ) ) )
			VAR _best = TOPN ( 1, _months, [@RevenueGrowth], DESC )
			VAR _bestGrowth = MAXX ( _best, [@RevenueGrowth] )
			VAR _bestMonth = MAXX ( _best, FORMAT ( DATE ( 'DateTable'[Year], 'DateTable'[Month_Number], 1 ), "mmmm" ) )
			RETURN
			    IF (
			        _monthCount > 0,
			        "Revenue and profit growth moved together in " & _sameDirection & " of " & _monthCount
			            & " months; revenue grew fastest in " & _bestMonth & " (" & FORMAT ( _bestGrowth, "+0.0%;-0.0%" ) & ")."
			    )
		displayFolder: Dashboard Design
		lineageTag: 2cd39440-b9c8-40a3-9183-c48d5992cdbf

	/// Upper bound for the column axis of the Category Performance chart: leaves headroom above the tallest column so the profit-margin line sits above the bars.
	measure 'Category Axis Max' =
			VAR _maxRevenue = MAXX ( VALUES ( 'ProductsTable'[Category] ), [Total Revenue] )
			RETURN
			    _maxRevenue * 1.7
		formatString: #,0
		displayFolder: Dashboard Design
		lineageTag: 579c901c-3b90-46c5-bead-4b352405d3db

	/// Upper bound for the column axis of the Bottom 5 Products chart (the five products with the lowest profit margin), with headroom for the margin line.
	measure 'Product Axis Max' =
			VAR _products =
			    FILTER ( VALUES ( 'ProductsTable'[Product_Name] ), NOT ISBLANK ( [Total Revenue] ) )
			VAR _bottom5 = TOPN ( 5, _products, [Profit Margin], ASC )
			RETURN
			    MAXX ( _bottom5, [Total Revenue] ) * 1.7
		formatString: #,0
		displayFolder: Dashboard Design
		lineageTag: cb73c414-2d3a-4b03-88ea-f9dd7dd02b9b

	/// Region with the highest Total Revenue in the current selection (Performance Breakdown highlight card).
	measure 'Top Region' =
			VAR _rows =
			    FILTER ( ADDCOLUMNS ( VALUES ( 'SalesTable'[Region] ), "@Revenue", [Total Revenue] ), NOT ISBLANK ( [@Revenue] ) )
			RETURN
			    MAXX ( TOPN ( 1, _rows, [@Revenue], DESC ), 'SalesTable'[Region] )
		displayFolder: Dashboard Design
		lineageTag: fe6e47f7-ca4a-4968-b21f-a5607ad80008

	/// Share of Total Revenue earned by the top region, e.g. "55.0% of total revenue".
	measure 'Top Region Caption' =
			VAR _rows =
			    FILTER ( ADDCOLUMNS ( VALUES ( 'SalesTable'[Region] ), "@Revenue", [Total Revenue] ), NOT ISBLANK ( [@Revenue] ) )
			VAR _topRevenue = MAXX ( _rows, [@Revenue] )
			RETURN
			    IF ( NOT ISBLANK ( _topRevenue ), FORMAT ( DIVIDE ( _topRevenue, [Total Revenue] ), "0.0%" ) & " of total revenue" )
		displayFolder: Dashboard Design
		lineageTag: 1f98a40c-be1c-45f0-a532-b28c08d76270

	/// Sales channel with the highest Total Revenue in the current selection.
	measure 'Top Sales Channel' =
			VAR _rows =
			    FILTER ( ADDCOLUMNS ( VALUES ( 'SalesTable'[Sales_Channel] ), "@Revenue", [Total Revenue] ), NOT ISBLANK ( [@Revenue] ) )
			RETURN
			    MAXX ( TOPN ( 1, _rows, [@Revenue], DESC ), 'SalesTable'[Sales_Channel] )
		displayFolder: Dashboard Design
		lineageTag: 1c6ad6d2-3819-4b45-bf73-066499bb8241

	/// Share of Total Revenue earned by the top sales channel.
	measure 'Top Sales Channel Caption' =
			VAR _rows =
			    FILTER ( ADDCOLUMNS ( VALUES ( 'SalesTable'[Sales_Channel] ), "@Revenue", [Total Revenue] ), NOT ISBLANK ( [@Revenue] ) )
			VAR _topRevenue = MAXX ( _rows, [@Revenue] )
			RETURN
			    IF ( NOT ISBLANK ( _topRevenue ), FORMAT ( DIVIDE ( _topRevenue, [Total Revenue] ), "0.0%" ) & " of total revenue" )
		displayFolder: Dashboard Design
		lineageTag: 44099a4c-a680-46d3-9ac1-5d4d6d24c3fc

	/// Product category with the highest Total Revenue in the current selection.
	measure 'Top Category' =
			VAR _rows =
			    FILTER ( ADDCOLUMNS ( VALUES ( 'ProductsTable'[Category] ), "@Revenue", [Total Revenue] ), NOT ISBLANK ( [@Revenue] ) )
			RETURN
			    MAXX ( TOPN ( 1, _rows, [@Revenue], DESC ), 'ProductsTable'[Category] )
		displayFolder: Dashboard Design
		lineageTag: db60ed68-8ba8-4b8f-a702-dddafdd88050

	/// Share of Total Revenue earned by the top category.
	measure 'Top Category Caption' =
			VAR _rows =
			    FILTER ( ADDCOLUMNS ( VALUES ( 'ProductsTable'[Category] ), "@Revenue", [Total Revenue] ), NOT ISBLANK ( [@Revenue] ) )
			VAR _topRevenue = MAXX ( _rows, [@Revenue] )
			RETURN
			    IF ( NOT ISBLANK ( _topRevenue ), FORMAT ( DIVIDE ( _topRevenue, [Total Revenue] ), "0.0%" ) & " of total revenue" )
		displayFolder: Dashboard Design
		lineageTag: d5acca76-2653-4e4f-89da-17c48b7d0a57

	/// Product category with the highest Profit Margin (categories with sales only).
	measure 'Best Margin Category' =
			VAR _rows =
			    FILTER ( ADDCOLUMNS ( VALUES ( 'ProductsTable'[Category] ), "@Margin", [Profit Margin], "@Revenue", [Total Revenue] ), [@Revenue] > 0 )
			RETURN
			    MAXX ( TOPN ( 1, _rows, [@Margin], DESC ), 'ProductsTable'[Category] )
		displayFolder: Dashboard Design
		lineageTag: 3ee22b9c-7517-4080-847c-3c809bd171db

	/// Profit Margin of the best-margin category, e.g. "63.1% profit margin".
	measure 'Best Margin Category Caption' =
			VAR _rows =
			    FILTER ( ADDCOLUMNS ( VALUES ( 'ProductsTable'[Category] ), "@Margin", [Profit Margin], "@Revenue", [Total Revenue] ), [@Revenue] > 0 )
			VAR _margin = MAXX ( _rows, [@Margin] )
			RETURN
			    IF ( NOT ISBLANK ( _margin ), FORMAT ( _margin, "0.0%" ) & " profit margin" )
		displayFolder: Dashboard Design
		lineageTag: 17ebb6c8-139a-4718-a8db-5ccef94e65dd

	/// Product with the lowest Profit Margin (products with sales only).
	measure 'Lowest Margin Product' =
			VAR _rows =
			    FILTER ( ADDCOLUMNS ( VALUES ( 'ProductsTable'[Product_Name] ), "@Margin", [Profit Margin], "@Revenue", [Total Revenue] ), [@Revenue] > 0 )
			RETURN
			    MAXX ( TOPN ( 1, _rows, [@Margin], ASC ), 'ProductsTable'[Product_Name] )
		displayFolder: Dashboard Design
		lineageTag: 6eb34f10-0be1-4372-b398-91eb4a1e0832

	/// Profit Margin of the lowest-margin product.
	measure 'Lowest Margin Product Caption' =
			VAR _rows =
			    FILTER ( ADDCOLUMNS ( VALUES ( 'ProductsTable'[Product_Name] ), "@Margin", [Profit Margin], "@Revenue", [Total Revenue] ), [@Revenue] > 0 )
			VAR _margin = MINX ( _rows, [@Margin] )
			RETURN
			    IF ( NOT ISBLANK ( _margin ), FORMAT ( _margin, "0.0%" ) & " profit margin" )
		displayFolder: Dashboard Design
		lineageTag: 3393b1cb-c3fe-412f-a6e7-fb32b3860108

	measure 'Weighted Avg Discount' =
			
			DIVIDE(
			    SUMX(
			        'SalesTable',
			        'SalesTable'[Gross_Sales] * 'SalesTable'[Discount_Pct]
			    ),
			    SUM('SalesTable'[Gross_Sales]),
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Dashboard Design
		lineageTag: 07ffac40-07b3-4255-aaa8-2d5484e2e3eb

	measure 'Returned Quantity' =
			
			CALCULATE(
			    [Total Quantity],
			    'SalesTable'[Order_Status] = "Returned"
			)
		formatString: 0
		displayFolder: Dashboard Design
		lineageTag: 176e5d70-b685-4811-817b-0f3d1a81b898

	measure 'Return Rate' =
			
			DIVIDE(
			    [Returned Quantity],
			    [Total Quantity],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Dashboard Design
		lineageTag: 5a823da8-1a58-49f1-a959-548bf5fa0ef5

	measure 'Total Cost' =
			
			SUMX(
			    'SalesTable',
			    'SalesTable'[Quantity] * 'SalesTable'[Unit_Cost]
			)
		formatString: #,0\ "₫";-#,0\ "₫";#,0\ "₫"
		lineageTag: a0ca5ea2-0857-47ea-b9f7-d458d9b724a9

	measure 'Cost Ratio' =
			
			DIVIDE(
			    [Total Cost],
			    SUM('SalesTable'[Gross_Sales]),
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 1e2123fd-b709-45b8-9be1-d1bc216f6981

	/// Average units per order line: shows whether discounts make customers buy more per purchase.
	measure 'Avg Units per Order Line' = DIVIDE ( [Total Quantity], COUNTROWS ( 'SalesTable' ) )
		formatString: 0.00
		displayFolder: Dashboard Design
		lineageTag: 15ffecb3-edd2-42e5-9b0e-79f2f4ae4aa5

	/// Change in Weighted Avg Discount versus the preceding period of the same length, in percentage points.
	measure 'Discount vs PP (pp)' =
			VAR _first = MIN ( 'DateTable'[Date] )
			VAR _last = MAX ( 'DateTable'[Date] )
			VAR _months = DATEDIFF ( _first, _last, MONTH ) + 1
			VAR _priorWindow = DATESBETWEEN ( 'DateTable'[Date], EDATE ( _first, - _months ), _first - 1 )
			VAR _priorRevenue = CALCULATE ( [Total Revenue], REMOVEFILTERS ( 'DateTable' ), _priorWindow )
			VAR _prior = CALCULATE ( [Weighted Avg Discount], REMOVEFILTERS ( 'DateTable' ), _priorWindow )
			RETURN
			    IF ( NOT ISBLANK ( _priorRevenue ), ( [Weighted Avg Discount] - _prior ) * 100 )
		formatString: \↑\ 0.00\ \p\p;\↓\ 0.00\ \p\p;0.00\ \p\p
		displayFolder: Dashboard Design
		lineageTag: fff91680-1995-4c04-8f9c-b3afa4151558

	/// Change in Return Rate versus the preceding period of the same length, in percentage points.
	measure 'Return Rate vs PP (pp)' =
			VAR _first = MIN ( 'DateTable'[Date] )
			VAR _last = MAX ( 'DateTable'[Date] )
			VAR _months = DATEDIFF ( _first, _last, MONTH ) + 1
			VAR _priorWindow = DATESBETWEEN ( 'DateTable'[Date], EDATE ( _first, - _months ), _first - 1 )
			VAR _priorRevenue = CALCULATE ( [Total Revenue], REMOVEFILTERS ( 'DateTable' ), _priorWindow )
			VAR _prior = CALCULATE ( [Return Rate], REMOVEFILTERS ( 'DateTable' ), _priorWindow )
			RETURN
			    IF ( NOT ISBLANK ( _priorRevenue ), ( [Return Rate] - _prior ) * 100 )
		formatString: \↑\ 0.00\ \p\p;\↓\ 0.00\ \p\p;0.00\ \p\p
		displayFolder: Dashboard Design
		lineageTag: 3d4c7227-3ba3-47a3-adf0-c6835fca006a

	/// Change in Cost Ratio versus the preceding period of the same length, in percentage points.
	measure 'Cost Ratio vs PP (pp)' =
			VAR _first = MIN ( 'DateTable'[Date] )
			VAR _last = MAX ( 'DateTable'[Date] )
			VAR _months = DATEDIFF ( _first, _last, MONTH ) + 1
			VAR _priorWindow = DATESBETWEEN ( 'DateTable'[Date], EDATE ( _first, - _months ), _first - 1 )
			VAR _priorRevenue = CALCULATE ( [Total Revenue], REMOVEFILTERS ( 'DateTable' ), _priorWindow )
			VAR _prior = CALCULATE ( [Cost Ratio], REMOVEFILTERS ( 'DateTable' ), _priorWindow )
			RETURN
			    IF ( NOT ISBLANK ( _priorRevenue ), ( [Cost Ratio] - _prior ) * 100 )
		formatString: \↑\ 0.00\ \p\p;\↓\ 0.00\ \p\p;0.00\ \p\p
		displayFolder: Dashboard Design
		lineageTag: bb56d49d-437e-4625-a8e4-2c31f458122f

	/// Green when the discount rate went down, red when it went up, grey without a prior period.
	measure 'Discount Delta Color' =
			VAR _change = [Discount vs PP (pp)]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _change ), "#8A94A6", _change <= 0, "#16A34A", "#DC2626" )
		displayFolder: Dashboard Design
		lineageTag: 6ad73ad8-569b-476b-bd10-8ddda31a34ed

	/// Green when the return rate went down, red when it went up, grey without a prior period.
	measure 'Return Rate Delta Color' =
			VAR _change = [Return Rate vs PP (pp)]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _change ), "#8A94A6", _change <= 0, "#16A34A", "#DC2626" )
		displayFolder: Dashboard Design
		lineageTag: 7a3a7b94-7483-42fb-9c25-f6d1f7903b0d

	/// Green when the cost ratio went down, red when it went up, grey without a prior period.
	measure 'Cost Ratio Delta Color' =
			VAR _change = [Cost Ratio vs PP (pp)]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _change ), "#8A94A6", _change <= 0, "#16A34A", "#DC2626" )
		displayFolder: Dashboard Design
		lineageTag: 4b22c124-4f3f-4761-8a6d-6eb8ba3605c9

	/// Average Total Revenue per product with sales; reference line on the product diagnosis scatter.
	measure 'Avg Product Revenue' = AVERAGEX ( VALUES ( 'ProductsTable'[Product_Name] ), [Total Revenue] )
		formatString: #,0\ "₫";-#,0\ "₫";#,0\ "₫"
		displayFolder: Dashboard Design
		lineageTag: e1acf309-2f0a-46ea-b024-7f03c7438217

	/// Scatter colour: red = revenue at or above average but margin below average, green = margin at or above average, grey = the rest.
	measure 'Product Diagnosis Color' =
			VAR _revenue = [Total Revenue]
			VAR _margin = [Profit Margin]
			VAR _avgRevenue = CALCULATE ( [Avg Product Revenue], ALLSELECTED ( 'ProductsTable' ) )
			VAR _avgMargin = CALCULATE ( [Profit Margin], ALLSELECTED ( 'ProductsTable' ) )
			RETURN
			    SWITCH ( TRUE (), _revenue >= _avgRevenue && _margin < _avgMargin, "#DC2626", _margin >= _avgMargin, "#10B981", "#94A3B8" )
		displayFolder: Dashboard Design
		lineageTag: 8ae51a3e-35f9-4ec4-8d29-9a7282499c0f

	/// Sentence for the product diagnosis section: how many products have above-average revenue but below-average margin.
	measure 'Product Diagnosis Insight' =
			VAR _avgRevenue = [Avg Product Revenue]
			VAR _avgMargin = [Profit Margin]
			VAR _flagged =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( 'ProductsTable'[Product_Name] ), "@Revenue", [Total Revenue], "@Margin", [Profit Margin] ),
			        NOT ISBLANK ( [@Revenue] ) && [@Revenue] >= _avgRevenue && [@Margin] < _avgMargin
			    )
			VAR _count = COUNTROWS ( _flagged ) + 0
			RETURN
			    _count & IF ( _count = 1, " product earns", " products earn" ) & " above-average revenue but below-average profit margin (red points) - check their cost ratio and discounts in the table."
		displayFolder: Dashboard Design
		lineageTag: 272e1921-0c0a-42b2-b3da-b59cd52f3b61

	/// Sentence for the discount chart: margin at the lowest vs highest discount level and the range of units per order line.
	measure 'Discount Insight' =
			VAR _levels =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( 'SalesTable'[Discount_Pct] ), "@Margin", [Profit Margin], "@Units", [Avg Units per Order Line], "@Revenue", [Total Revenue] ),
			        [@Revenue] > 0
			    )
			VAR _low = MINX ( _levels, 'SalesTable'[Discount_Pct] )
			VAR _high = MAXX ( _levels, 'SalesTable'[Discount_Pct] )
			VAR _marginLow = MAXX ( FILTER ( _levels, 'SalesTable'[Discount_Pct] = _low ), [@Margin] )
			VAR _marginHigh = MAXX ( FILTER ( _levels, 'SalesTable'[Discount_Pct] = _high ), [@Margin] )
			RETURN
			    IF (
			        COUNTROWS ( _levels ) > 1,
			        "Profit margin " & IF ( _marginHigh < _marginLow, "falls", "rises" ) & " from " & FORMAT ( _marginLow, "0.0%" ) & " at " & FORMAT ( _low, "0%" )
			            & " discount to " & FORMAT ( _marginHigh, "0.0%" ) & " at " & FORMAT ( _high, "0%" )
			            & ", while units per order line stay between " & FORMAT ( MINX ( _levels, [@Units] ), "0.00" ) & " and " & FORMAT ( MAXX ( _levels, [@Units] ), "0.00" ) & "."
			    )
		displayFolder: Dashboard Design
		lineageTag: 8053aced-2774-4f8c-8be4-8d5ba3a6ab8e

	/// Sentence for the cost-ratio chart: category with the highest cost ratio and the one with the lowest margin.
	measure 'Category Insight' =
			VAR _categories =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( 'ProductsTable'[Category] ), "@Cost", [Cost Ratio], "@Margin", [Profit Margin], "@Revenue", [Total Revenue] ),
			        [@Revenue] > 0
			    )
			VAR _topCost = TOPN ( 1, _categories, [@Cost], DESC )
			VAR _lowMargin = TOPN ( 1, _categories, [@Margin], ASC )
			VAR _costName = MAXX ( _topCost, 'ProductsTable'[Category] )
			VAR _marginName = MAXX ( _lowMargin, 'ProductsTable'[Category] )
			RETURN
			    IF (
			        NOT ISBLANK ( _costName ),
			        _costName & " has the highest cost ratio (" & FORMAT ( MAXX ( _topCost, [@Cost] ), "0.0%" ) & ")"
			            & IF (
			                _costName = _marginName,
			                " and the lowest profit margin (" & FORMAT ( MAXX ( _lowMargin, [@Margin] ), "0.0%" ) & ").",
			                "; the lowest profit margin is " & _marginName & " (" & FORMAT ( MAXX ( _lowMargin, [@Margin] ), "0.0%" ) & ")."
			            )
			    )
		displayFolder: Dashboard Design
		lineageTag: f09e3cf0-df9d-428b-92ab-5d2cb4db977d

	/// Upper bound for the column axis of the discount chart, leaving room for the margin line above the columns.
	measure 'Discount Chart Axis Max' = MAXX ( VALUES ( 'SalesTable'[Discount_Pct] ), [Avg Units per Order Line] ) * 1.8
		formatString: 0.00
		displayFolder: Dashboard Design
		lineageTag: f53bf816-55fd-4fc0-aff0-fb7a38e08769

	/// Category of the product in the current row; used as a column in the product diagnosis table.
	measure 'Product Category Label' = SELECTEDVALUE ( 'ProductsTable'[Category] )
		displayFolder: Dashboard Design
		lineageTag: bc6fd89b-e8a5-4e1d-b070-7e8c39807ac6

	/// Cell colour for Profit Margin in the product table: green at or above 55%, red below 45%, white in between.
	measure 'Margin Cell Color' =
			VAR _margin = [Profit Margin]
			RETURN
			    SWITCH ( TRUE (), _margin >= 0.55, "#C9EDD8", _margin < 0.45, "#F8C4C4", "#FFFFFF" )
		displayFolder: Dashboard Design
		lineageTag: 0f1ff040-acd3-4b13-b924-14a94d29f715

	/// Cell colour for Cost Ratio: green below 40% of gross sales, red above 52%.
	measure 'Cost Ratio Cell Color' =
			VAR _value = [Cost Ratio]
			RETURN
			    SWITCH ( TRUE (), _value <= 0.4, "#C9EDD8", _value >= 0.52, "#F8C4C4", "#FFFFFF" )
		displayFolder: Dashboard Design
		lineageTag: dafd71f4-03ce-44c9-bca9-2783fec0d78e

	/// Cell colour for Avg Discount: green at or below 6%, red at or above 10%.
	measure 'Discount Cell Color' =
			VAR _value = [Weighted Avg Discount]
			RETURN
			    SWITCH ( TRUE (), _value <= 0.06, "#C9EDD8", _value >= 0.1, "#F8C4C4", "#FFFFFF" )
		displayFolder: Dashboard Design
		lineageTag: cdba2c02-7588-4c00-851b-f78936c16cb0

	/// Cell colour for Return Rate: green at or below 2%, red at or above 5%.
	measure 'Return Rate Cell Color' =
			VAR _value = [Return Rate]
			RETURN
			    SWITCH ( TRUE (), _value <= 0.02, "#C9EDD8", _value >= 0.05, "#F8C4C4", "#FFFFFF" )
		displayFolder: Dashboard Design
		lineageTag: 2f7e3253-6e1d-44e7-993f-ea8e697075d2

	/// Customers with at least one order in the current selection.
	measure 'Active Customers' = DISTINCTCOUNT ( 'SalesTable'[Customer_ID] )
		formatString: #,0
		displayFolder: Customer Analysis
		lineageTag: 09df5913-15d2-4d9b-b270-b87b25b4889b

	/// Distinct orders in the current selection.
	measure 'Total Orders' = DISTINCTCOUNT ( 'SalesTable'[Order_ID] )
		formatString: #,0
		displayFolder: Customer Analysis
		lineageTag: 5a99a12e-edf8-4a7d-9bb9-c216b41c823d

	/// Total Revenue divided by the number of active customers.
	measure 'Revenue per Customer' = DIVIDE ( [Total Revenue], [Active Customers] )
		formatString: #,0\ "₫";-#,0\ "₫";#,0\ "₫"
		displayFolder: Customer Analysis
		lineageTag: 14905e05-764e-4dc9-987a-3f05bb67779b

	/// Total Revenue divided by the number of orders.
	measure 'Avg Order Value' = DIVIDE ( [Total Revenue], [Total Orders] )
		formatString: #,0\ "₫";-#,0\ "₫";#,0\ "₫"
		displayFolder: Customer Analysis
		lineageTag: 15555c31-abf0-43e5-a9e2-ec729d924125

	/// Average number of orders per active customer.
	measure 'Orders per Customer' = DIVIDE ( [Total Orders], [Active Customers] )
		formatString: 0.00
		displayFolder: Customer Analysis
		lineageTag: a0292098-1cbb-4857-b4cb-4641064f6ab7

	/// Customers with two or more orders in the current selection.
	measure 'Repeat Customers' = COUNTROWS ( FILTER ( VALUES ( 'SalesTable'[Customer_ID] ), [Total Orders] >= 2 ) ) + 0
		formatString: #,0
		displayFolder: Customer Analysis
		lineageTag: 46b786bd-8660-48d6-80f0-50e15223b157

	/// Share of active customers who ordered more than once.
	measure 'Repeat Rate' = DIVIDE ( [Repeat Customers], [Active Customers] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Customer Analysis
		lineageTag: bc864329-ea15-4aaf-8124-ec2077bce478

	/// Active customers whose Join_Date falls inside the selected period.
	measure 'New Customers' =
			VAR _first = MIN ( 'DateTable'[Date] )
			VAR _last = MAX ( 'DateTable'[Date] )
			RETURN
			    COUNTROWS (
			        FILTER (
			            VALUES ( 'CustomersTable'[Customer_ID] ),
			            VAR _join = CALCULATE ( MIN ( 'CustomersTable'[Join_Date] ) )
			            VAR _orders = CALCULATE ( DISTINCTCOUNT ( 'SalesTable'[Order_ID] ) )
			            RETURN
			                _orders > 0 && _join >= _first && _join <= _last
			        )
			    ) + 0
		formatString: #,0
		displayFolder: Customer Analysis
		lineageTag: f2bdeb81-898f-41dc-bd48-357d2e5e81f6

	/// Active customers who joined before the selected period.
	measure 'Returning Customers' = [Active Customers] - [New Customers]
		formatString: #,0
		displayFolder: Customer Analysis
		lineageTag: b3c9eae2-53a0-4a1b-9bcf-f9c621186320

	/// Median revenue per active customer.
	measure 'Median Customer Revenue' = MEDIANX ( VALUES ( 'SalesTable'[Customer_ID] ), [Total Revenue] )
		formatString: #,0\ "₫";-#,0\ "₫";#,0\ "₫"
		displayFolder: Customer Analysis
		lineageTag: a99bd51d-be94-4ff6-a9a5-947976bee264

	/// Highest number of orders placed by a single customer.
	measure 'Max Orders per Customer' = MAXX ( VALUES ( 'SalesTable'[Customer_ID] ), [Total Orders] ) + 0
		formatString: #,0
		displayFolder: Customer Analysis
		lineageTag: 838ab329-f885-42fd-b597-abc7d818880d

	/// Caption under the customer count: new versus returning.
	measure 'Customers Caption' = FORMAT ( [New Customers], "#,0" ) & " new" & " · " & FORMAT ( [Returning Customers], "#,0" ) & " returning"
		displayFolder: Customer Analysis
		lineageTag: a8800d50-b0a7-480d-bcae-c89d7cb3ed0e

	/// Caption under revenue per customer: the median customer.
	measure 'Revenue per Customer Caption' = "median " & FORMAT ( [Median Customer Revenue] / 1e6, "0.0" ) & "M ₫"
		displayFolder: Customer Analysis
		lineageTag: 73b0b345-4c8c-4112-98df-35764e35b0b9

	/// Caption under average order value: order count.
	measure 'Avg Order Value Caption' = FORMAT ( [Total Orders], "#,0" ) & " orders in total"
		displayFolder: Customer Analysis
		lineageTag: 92f409bb-034f-4a06-bad6-f57725fcae6b

	/// Caption under orders per customer: the most active customer.
	measure 'Orders per Customer Caption' = "most active customer: " & FORMAT ( [Max Orders per Customer], "#,0" ) & " orders"
		displayFolder: Customer Analysis
		lineageTag: 264072cb-0989-4651-9b4e-0b05b67c624b

	/// Caption under repeat rate: how many customers ordered again.
	measure 'Repeat Rate Caption' = FORMAT ( [Repeat Customers], "#,0" ) & " of " & FORMAT ( [Active Customers], "#,0" ) & " customers"
		displayFolder: Customer Analysis
		lineageTag: ed1a1aeb-dbd7-4ece-a7b8-ad6d13b1a813

	/// Running share of revenue when customers are ranked from the largest to the smallest.
	measure 'Cumulative Revenue %' =
			VAR _current = [Total Revenue]
			VAR _customers =
			    CALCULATETABLE ( ADDCOLUMNS ( VALUES ( 'SalesTable'[Customer_ID] ), "@Revenue", [Total Revenue] ), ALLSELECTED ( 'SalesTable' ) )
			VAR _total = SUMX ( _customers, [@Revenue] )
			VAR _cumulative = SUMX ( FILTER ( _customers, [@Revenue] >= _current ), [@Revenue] )
			RETURN
			    IF ( NOT ISBLANK ( _current ), DIVIDE ( _cumulative, _total ) )
		formatString: 0%;-0%;0%
		displayFolder: Customer Analysis
		lineageTag: 3a2618c6-d7e4-40f7-8d4a-f50789100827

	/// Sentence for the Pareto chart: revenue share of the top 10% and top 20% of customers.
	measure 'Value Concentration Insight' =
			VAR _customers =
			    CALCULATETABLE ( ADDCOLUMNS ( VALUES ( 'SalesTable'[Customer_ID] ), "@Revenue", [Total Revenue] ), ALLSELECTED ( 'SalesTable' ) )
			VAR _count = COUNTROWS ( _customers )
			VAR _total = SUMX ( _customers, [@Revenue] )
			VAR _top10 = ROUND ( _count * 0.1, 0 )
			VAR _top20 = ROUND ( _count * 0.2, 0 )
			RETURN
			    IF (
			        _count > 10,
			        "The top 10% of customers (" & FORMAT ( _top10, "#,0" ) & " of " & FORMAT ( _count, "#,0" ) & ") bring "
			            & FORMAT ( DIVIDE ( SUMX ( TOPN ( _top10, _customers, [@Revenue], DESC ), [@Revenue] ), _total ), "0.0%" )
			            & " of revenue; the top 20% bring "
			            & FORMAT ( DIVIDE ( SUMX ( TOPN ( _top20, _customers, [@Revenue], DESC ), [@Revenue] ), _total ), "0.0%" ) & "."
			    )
		displayFolder: Customer Analysis
		lineageTag: 205dd561-5ba0-47ae-8d3b-8de995e39cc8

	/// Days between a customer's last order and the latest order date in the selection.
	measure 'Days Since Last Order' =
			VAR _reference = CALCULATE ( MAX ( 'SalesTable'[Order_Date] ), ALLSELECTED ( 'SalesTable' ) )
			VAR _last = MAX ( 'SalesTable'[Order_Date] )
			RETURN
			    IF ( NOT ISBLANK ( _last ), DATEDIFF ( _last, _reference, DAY ) )
		formatString: #,0
		displayFolder: Customer Analysis
		lineageTag: b29592da-0ade-45d2-ae09-c991892b82e2

	/// Behaviour segment: Champion, Loyal, At risk, One-time or Occasional.
	measure 'Customer Segment' =
			VAR _orders = [Total Orders]
			VAR _revenue = [Total Revenue]
			VAR _recency = [Days Since Last Order]
			VAR _avgRevenue = CALCULATE ( [Revenue per Customer], ALLSELECTED ( 'SalesTable'[Customer_ID] ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _orders ), BLANK (),
			        _recency > 90, "At risk",
			        _orders >= 3 && _revenue >= _avgRevenue, "Champion",
			        _orders >= 3, "Loyal",
			        _orders = 1, "One-time",
			        "Occasional"
			    )
		displayFolder: Customer Analysis
		lineageTag: 3c301223-fa47-49c9-b456-5841f534e141

	/// Colour for the customer segment: green for Champion and Loyal, red for At risk.
	measure 'Segment Color' =
			VAR _segment = [Customer Segment]
			RETURN
			    SWITCH (
			        _segment,
			        "Champion", "#10B981",
			        "Loyal", "#34D399",
			        "At risk", "#DC2626",
			        "One-time", "#F59E0B",
			        "#94A3B8"
			    )
		displayFolder: Customer Analysis
		lineageTag: 112743a1-f1dd-44cd-a646-78d96f73cbcc

	/// Number of active customers in the current segment bucket.
	measure 'Customers in Segment' = COUNTROWS ( FILTER ( VALUES ( 'SalesTable'[Customer_ID] ), NOT ISBLANK ( [Total Orders] ) ) ) + 0
		formatString: #,0
		displayFolder: Customer Analysis
		lineageTag: f25f4667-582d-4693-8c59-79c63367732c

	/// Sentence for the member tier chart: which tier brings the most revenue and how average order value compares.
	measure 'Tier Insight' =
			VAR _tiers =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( 'CustomersTable'[Member_Tier] ), "@Revenue", [Total Revenue], "@AOV", [Avg Order Value] ),
			        [@Revenue] > 0 && NOT ISBLANK ( 'CustomersTable'[Member_Tier] )
			    )
			VAR _top = TOPN ( 1, _tiers, [@Revenue], DESC )
			VAR _total = SUMX ( _tiers, [@Revenue] )
			RETURN
			    IF (
			        COUNTROWS ( _tiers ) > 1,
			        MAXX ( _top, 'CustomersTable'[Member_Tier] ) & " brings the most revenue ("
			            & FORMAT ( DIVIDE ( MAXX ( _top, [@Revenue] ), _total ), "0.0%" ) & "), while average order value stays between "
			            & FORMAT ( MINX ( _tiers, [@AOV] ) / 1e6, "0.00" ) & "M and " & FORMAT ( MAXX ( _tiers, [@AOV] ) / 1e6, "0.00" ) & "M ₫ across tiers."
			    )
		displayFolder: Customer Analysis
		lineageTag: 86eed1fa-25d4-4741-ab5d-a12538795511

	/// Sentence for the acquisition chart: strongest source by revenue and by revenue per customer.
	measure 'Acquisition Insight' =
			VAR _sources =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( 'CustomersTable'[Acquisition_Source] ), "@Revenue", [Total Revenue], "@PerCustomer", [Revenue per Customer] ),
			        [@Revenue] > 0 && NOT ISBLANK ( 'CustomersTable'[Acquisition_Source] )
			    )
			VAR _topRevenue = TOPN ( 1, _sources, [@Revenue], DESC )
			VAR _topPer = TOPN ( 1, _sources, [@PerCustomer], DESC )
			RETURN
			    IF (
			        COUNTROWS ( _sources ) > 1,
			        MAXX ( _topRevenue, 'CustomersTable'[Acquisition_Source] ) & " brings the most revenue, while "
			            & MAXX ( _topPer, 'CustomersTable'[Acquisition_Source] ) & " has the highest revenue per customer ("
			            & FORMAT ( MAXX ( _topPer, [@PerCustomer] ) / 1e6, "0.0" ) & "M ₫)."
			    )
		displayFolder: Customer Analysis
		lineageTag: 226da7c8-d1d4-4912-9bc8-942542b1ae76

	/// Sentence for the segment chart: how many champions and how many customers are at risk.
	measure 'Segment Insight' =
			VAR _customers =
			    ADDCOLUMNS ( VALUES ( 'SalesTable'[Customer_ID] ), "@Segment", [Customer Segment] )
			VAR _champions = COUNTROWS ( FILTER ( _customers, [@Segment] = "Champion" ) ) + 0
			VAR _atRisk = COUNTROWS ( FILTER ( _customers, [@Segment] = "At risk" ) ) + 0
			VAR _total = COUNTROWS ( _customers )
			RETURN
			    IF (
			        _total > 0,
			        FORMAT ( _champions, "#,0" ) & " champions drive the business, while " & FORMAT ( _atRisk, "#,0" )
			            & " customers have not ordered in the last 90 days of the selection."
			    )
		displayFolder: Customer Analysis
		lineageTag: 0b921b67-91ae-4561-8e48-87160a5b95f6

	/// Upper bound for the Pareto column axis so the cumulative line stays above the columns.
	measure 'Customer Pareto Axis Max' = MAXX ( VALUES ( 'SalesTable'[Customer_ID] ), [Total Revenue] ) * 1.7
		formatString: #,0
		displayFolder: Customer Analysis
		lineageTag: cc1f0000-5dea-4f71-8aa3-4618689b9721

	/// Member tier of the customer in the current row.
	measure 'Member Tier Label' = SELECTEDVALUE ( 'CustomersTable'[Member_Tier], "—" )
		displayFolder: Customer Analysis
		lineageTag: 7f07da86-9b80-4db2-8de3-3ff81596b860

	/// City of the customer in the current row.
	measure 'Customer City Label' = SELECTEDVALUE ( 'CustomersTable'[City], "—" )
		displayFolder: Customer Analysis
		lineageTag: b64be1ad-fadf-4e60-aa0c-e7a1ecf5201a

	/// Average number of days between two orders of the same customer (customers with at least two orders).
	measure 'Avg Days Between Orders' =
			VAR _customers =
			    ADDCOLUMNS (
			        FILTER ( VALUES ( 'SalesTable'[Customer_ID] ), [Total Orders] >= 2 ),
			        "@Gap",
			            VAR _first = CALCULATE ( MIN ( 'SalesTable'[Order_Date] ) )
			            VAR _last = CALCULATE ( MAX ( 'SalesTable'[Order_Date] ) )
			            RETURN DIVIDE ( DATEDIFF ( _first, _last, DAY ), [Total Orders] - 1 )
			    )
			RETURN
			    AVERAGEX ( _customers, [@Gap] )
		formatString: #,0
		displayFolder: Customer Retention
		lineageTag: a33ce038-c6c8-4528-b825-f428e0311861

	/// Customers whose last order is more than 90 days before the most recent order in the selection.
	measure 'Customers At Risk' = COUNTROWS ( FILTER ( VALUES ( 'SalesTable'[Customer_ID] ), [Customer Segment] = "At risk" ) ) + 0
		formatString: #,0
		displayFolder: Customer Retention
		lineageTag: abe04ccf-d262-45c0-97c2-0bcf4b02eeff

	/// Revenue earned by the customers currently flagged as At risk.
	measure 'Revenue At Risk' = SUMX ( FILTER ( VALUES ( 'SalesTable'[Customer_ID] ), [Customer Segment] = "At risk" ), [Total Revenue] )
		formatString: #,0\ "₫";-#,0\ "₫";#,0\ "₫"
		displayFolder: Customer Retention
		lineageTag: 8461741d-d24c-4ed2-87c7-f03be5450fa8

	/// At-risk customers whose revenue is at or above the average revenue per customer.
	measure 'High Value At Risk' =
			VAR _average = CALCULATE ( [Revenue per Customer], ALLSELECTED ( 'SalesTable'[Customer_ID] ) )
			RETURN
			    COUNTROWS ( FILTER ( VALUES ( 'SalesTable'[Customer_ID] ), [Customer Segment] = "At risk" && [Total Revenue] >= _average ) ) + 0
		formatString: #,0
		displayFolder: Customer Retention
		lineageTag: 53f5b60d-1e4b-4673-968a-0db352813c69

	/// Order lines that carry a customer rating.
	measure 'Rated Orders' = COUNTROWS ( FILTER ( 'SalesTable', NOT ISBLANK ( 'SalesTable'[Customer_Rating] ) ) ) + 0
		formatString: #,0
		displayFolder: Customer Retention
		lineageTag: c0b3b5f2-bbac-4cea-9455-bfe7b22f828c

	/// Average customer rating (1 to 5) across rated order lines.
	measure 'Avg Customer Rating' = AVERAGEX ( FILTER ( 'SalesTable', NOT ISBLANK ( 'SalesTable'[Customer_Rating] ) ), VALUE ( 'SalesTable'[Customer_Rating] ) )
		formatString: 0.0
		displayFolder: Customer Retention
		lineageTag: 4748f396-9752-4d6f-a015-6fa0128db9d8

	/// Share of rated order lines with 4 or 5 stars.
	measure 'Happy Orders %' =
			VAR _rated = [Rated Orders]
			VAR _happy = COUNTROWS ( FILTER ( 'SalesTable', NOT ISBLANK ( 'SalesTable'[Customer_Rating] ) && VALUE ( 'SalesTable'[Customer_Rating] ) >= 4 ) )
			RETURN
			    DIVIDE ( _happy, _rated )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Customer Retention
		lineageTag: 1d196dcd-1595-4fc3-bb1c-6cae1991f570

	/// Share of order lines placed on the channel the customer declared as preferred.
	measure 'Channel Match Rate' =
			VAR _total = COUNTROWS ( 'SalesTable' )
			VAR _matched =
			    COUNTROWS (
			        FILTER ( 'SalesTable', RELATED ( 'CustomersTable'[Preferred_Channel] ) = 'SalesTable'[Sales_Channel] )
			    )
			RETURN
			    DIVIDE ( _matched, _total )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Customer Retention
		lineageTag: a19f230b-0988-429a-9940-7772c49d83c6

	/// Caption: how the gap compares with the 90 day at-risk threshold.
	measure 'Avg Days Between Orders Caption' = "at-risk threshold is 90 days"
		displayFolder: Customer Retention
		lineageTag: 51766415-c446-4169-aa56-a2ec631623f5

	/// Caption: how many at-risk customers spend above average.
	measure 'Customers At Risk Caption' = FORMAT ( [High Value At Risk], "#,0" ) & " of them spend above average"
		displayFolder: Customer Retention
		lineageTag: 1f261d84-86d1-4199-836f-6c1341ec8fdc

	/// Caption: share of revenue tied to at-risk customers.
	measure 'Revenue At Risk Caption' = FORMAT ( DIVIDE ( [Revenue At Risk], [Total Revenue] ), "0.0%" ) & " of total revenue"
		displayFolder: Customer Retention
		lineageTag: e72525c4-f8a2-4499-811f-873ba0b009c9

	/// Caption: how many order lines carry a rating.
	measure 'Avg Customer Rating Caption' = FORMAT ( [Rated Orders], "#,0" ) & " rated orders · " & FORMAT ( [Happy Orders %], "0.0%" ) & " gave 4-5 stars"
		displayFolder: Customer Retention
		lineageTag: bf65c558-3643-4fbe-b345-e53e34124157

	/// Caption: what the channel match rate means.
	measure 'Channel Match Rate Caption' = "orders placed on the declared preferred channel"
		displayFolder: Customer Retention
		lineageTag: a2df9533-6db3-403d-a306-fb8960d9a735

	/// Sentence for the monthly chart: how first-time and repeat buyers moved across the selected months.
	measure 'Retention Insight' =
			VAR _months =
			    FILTER (
			        ADDCOLUMNS (
			            SUMMARIZE ( 'DateTable', 'DateTable'[Year], 'DateTable'[Month_Number] ),
			            "@Active", [Active Customers], "@New", [First-time Buyers]
			        ),
			        [@Active] > 0
			    )
			VAR _firstKey = MINX ( _months, 'DateTable'[Year] * 100 + 'DateTable'[Month_Number] )
			VAR _lastKey = MAXX ( _months, 'DateTable'[Year] * 100 + 'DateTable'[Month_Number] )
			VAR _firstRow = FILTER ( _months, 'DateTable'[Year] * 100 + 'DateTable'[Month_Number] = _firstKey )
			VAR _lastRow = FILTER ( _months, 'DateTable'[Year] * 100 + 'DateTable'[Month_Number] = _lastKey )
			VAR _firstActive = MAXX ( _firstRow, [@Active] )
			VAR _lastActive = MAXX ( _lastRow, [@Active] )
			VAR _firstNew = MAXX ( _firstRow, [@New] )
			VAR _lastNew = MAXX ( _lastRow, [@New] )
			RETURN
			    IF (
			        COUNTROWS ( _months ) > 1,
			        "Active customers moved from " & FORMAT ( _firstActive, "#,0" ) & " in " & FORMAT ( DATE ( INT ( _firstKey / 100 ), MOD ( _firstKey, 100 ), 1 ), "mmm yyyy" )
			            & " to " & FORMAT ( _lastActive, "#,0" ) & " in " & FORMAT ( DATE ( INT ( _lastKey / 100 ), MOD ( _lastKey, 100 ), 1 ), "mmm yyyy" )
			            & ". First-time buyers fell from " & FORMAT ( _firstNew, "#,0" ) & " to " & FORMAT ( _lastNew, "#,0" )
			            & ", while repeat buyers grew from " & FORMAT ( _firstActive - _firstNew, "#,0" ) & " to " & FORMAT ( _lastActive - _lastNew, "#,0" ) & "."
			    )
		displayFolder: Customer Retention
		lineageTag: 02c07c97-0c1a-45b7-8bbf-85f87412f072

	/// Sentence for the rating distribution: overall rating and the share of unhappy orders.
	measure 'Rating Insight' =
			VAR _low =
			    CALCULATE (
			        [Rated Orders],
			        FILTER ( 'SalesTable', NOT ISBLANK ( 'SalesTable'[Customer_Rating] ) && VALUE ( 'SalesTable'[Customer_Rating] ) <= 2 )
			    )
			RETURN
			    "Average rating is " & FORMAT ( [Avg Customer Rating], "0.0" ) & " out of 5 and " & FORMAT ( [Happy Orders %], "0.0%" )
			        & " of rated orders gave 4 or 5 stars, but " & FORMAT ( _low, "#,0" ) & " orders ("
			        & FORMAT ( DIVIDE ( _low, [Rated Orders] ), "0.0%" ) & ") rated 1 or 2 stars."
		displayFolder: Customer Retention
		lineageTag: 1c090c56-8b9d-468b-ab30-768dd07cef97

	/// Sentence for the channel matrix: how often customers buy on the channel they declared.
	measure 'Channel Insight' = "Only " & FORMAT ( [Channel Match Rate], "0.0%" ) & " of orders are placed on the channel the customer declared as preferred, so the declared preference is a weak targeting signal."
		displayFolder: Customer Retention
		lineageTag: 13e12850-7904-43fe-b122-3f2a05221ecc

	/// Sentence for the win-back list: how much revenue sits with at-risk customers.
	measure 'At Risk Insight' =
			FORMAT ( [Customers At Risk], "#,0" ) & " customers have gone quiet for more than 90 days, carrying "
			    & FORMAT ( [Revenue At Risk] / 1e6, "#,0" ) & "M ₫ (" & FORMAT ( DIVIDE ( [Revenue At Risk], [Total Revenue] ), "0.0%" ) & " of revenue); "
			    & FORMAT ( [High Value At Risk], "#,0" ) & " of them spend above average."
		displayFolder: Customer Retention
		lineageTag: f09eee66-1a07-4fff-af07-501dfb33fd34

	/// Customers whose first ever order falls inside the selected period.
	measure 'First-time Buyers' =
			CALCULATE (
			    DISTINCTCOUNT ( 'SalesTable'[Customer_ID] ),
			    FILTER ( 'SalesTable', 'SalesTable'[Order_Date] = 'SalesTable'[First_Purchase_Date] )
			) + 0
		formatString: #,0
		displayFolder: Customer Retention
		lineageTag: ce92a89a-2873-44cb-b083-b4b15d8cf33f

	/// Active customers who had already ordered before the selected period.
	measure 'Repeat Buyers' = [Active Customers] - [First-time Buyers]
		formatString: #,0
		displayFolder: Customer Retention
		lineageTag: 663a4693-2a28-42c9-b655-55794274af04

	/// Sentence for the delivery chart: how late delivery and returns pull ratings down.
	measure 'Delivery Insight' =
			VAR _onTime = CALCULATE ( [Avg Customer Rating], 'SalesTable'[Delivery_Days] = "0" )
			VAR _late =
			    CALCULATE (
			        [Avg Customer Rating],
			        FILTER ( 'SalesTable', NOT ISBLANK ( 'SalesTable'[Delivery_Days] ) && 'SalesTable'[Delivery_Days] <> "0" )
			    )
			VAR _lateOrders =
			    CALCULATE (
			        [Rated Orders],
			        FILTER ( 'SalesTable', NOT ISBLANK ( 'SalesTable'[Delivery_Days] ) && 'SalesTable'[Delivery_Days] <> "0" )
			    )
			VAR _returned = CALCULATE ( [Avg Customer Rating], 'SalesTable'[Order_Status] = "Returned" )
			RETURN
			    "Orders delivered on time average " & FORMAT ( _onTime, "0.0" ) & " stars; the " & FORMAT ( _lateOrders, "#,0" )
			        & " late ones average " & FORMAT ( _late, "0.0" ) & ", and returned orders only " & FORMAT ( _returned, "0.0" ) & "."
		displayFolder: Customer Retention
		lineageTag: 1994be32-91b5-4eb2-b6d5-d4b1a852b722

	/// Member tier, shown only for customers flagged as At risk.
	measure 'Win-back Tier' = IF ( [Customer Segment] = "At risk", [Member Tier Label] )
		displayFolder: Customer Retention
		lineageTag: 7c04b8ed-29f4-495b-879e-004c9d81caaa

	/// Order count, shown only for customers flagged as At risk.
	measure 'Win-back Orders' = IF ( [Customer Segment] = "At risk", [Total Orders] )
		formatString: #,0
		displayFolder: Customer Retention
		lineageTag: 144c50ff-a3a9-44a1-aa09-bc21cfc490f0

	/// Revenue, shown only for customers flagged as At risk.
	measure 'Win-back Revenue' = IF ( [Customer Segment] = "At risk", [Total Revenue] )
		formatString: #,0\ "₫";-#,0\ "₫";#,0\ "₫"
		displayFolder: Customer Retention
		lineageTag: 454b2b2d-7406-4ccc-8199-362143368a33

	/// Days since the last order, shown only for customers flagged as At risk.
	measure 'Win-back Days Quiet' = IF ( [Customer Segment] = "At risk", [Days Since Last Order] )
		formatString: #,0
		displayFolder: Customer Retention
		lineageTag: 66e89beb-7fc9-4935-83ab-e10edcd83fe4

