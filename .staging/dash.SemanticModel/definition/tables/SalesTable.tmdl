table SalesTable
	lineageTag: 46aca378-7cff-4949-bee7-1f0dd07f0d84

	measure 'Total Revenue' = SUM('SalesTable'[Net_Sales])
		formatString: #,0.00\ "₫";-#,0.00\ "₫";#,0.00\ "₫"
		lineageTag: 4f6271dd-47ad-4f32-9927-14e90d3c5b8f

		annotation PBI_FormatHint = {"currencyCulture":"vi-VN"}

	measure 'Total Profit' =
			
			SUM('SalesTable'[Gross_Profit])
		formatString: #,0.00\ "₫";-#,0.00\ "₫";#,0.00\ "₫"
		lineageTag: 6c2144fa-102d-49e6-a7eb-72f17f87aa55

		annotation PBI_FormatHint = {"currencyCulture":"vi-VN"}

	measure 'Total Quantity' =
			
			SUM('SalesTable'[Quantity])
		formatString: 0
		lineageTag: 463f90c6-d1b0-46f0-94bf-e63964435601

	measure 'Profit Margin' =
			
			DIVIDE(
			    [Total Profit],
			    [Total Revenue],
			    0
			)
		formatString: #,0.00%;-#,0.00%;#,0.00%
		lineageTag: 4b8a7440-51cb-4924-bf07-82bdc9ec9dfd

	measure 'Previous Month Revenue' =
			
			CALCULATE(
			    [Total Revenue],
			    DATEADD('DateTable'[Date], -1, MONTH)
			)
		lineageTag: e4f3e57f-6985-453d-b0a3-127ee20f4ef5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'MoM Revenue Growth' =
			
			DIVIDE(
			    [Total Revenue] - [Previous Month Revenue],
			    [Previous Month Revenue]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 61435ab7-f0e5-42a0-be06-3e498e62ddb5

	measure 'Previous Month Profit' =
			
			CALCULATE(
			    [Total Profit],
			    DATEADD('DateTable'[Date], -1, MONTH)
			)
		lineageTag: a742a48b-42f6-4bd7-923b-d0947b770958

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'MoM Profit Growth' =
			
			DIVIDE(
			    [Total Profit] - [Previous Month Profit],
			    [Previous Month Profit]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9ff6bd69-2f0d-471c-95e7-ec7dd0f87946

	/// Change in Total Revenue versus the immediately preceding period of the same length (in months). Blank when no prior data exists.
	measure 'Revenue vs PP %' =
			VAR _first = MIN ( 'DateTable'[Date] )
			VAR _last = MAX ( 'DateTable'[Date] )
			VAR _months = DATEDIFF ( _first, _last, MONTH ) + 1
			VAR _prior =
			    CALCULATE (
			        [Total Revenue],
			        REMOVEFILTERS ( 'DateTable' ),
			        DATESBETWEEN ( 'DateTable'[Date], EDATE ( _first, - _months ), _first - 1 )
			    )
			VAR _current = [Total Revenue]
			RETURN
			    IF ( NOT ISBLANK ( _prior ), DIVIDE ( _current - _prior, _prior ) )
		formatString: \↑\ 0.00%;\↓\ 0.00%;0.00%
		displayFolder: Dashboard Design

	/// Change in Total Profit versus the immediately preceding period of the same length (in months). Blank when no prior data exists.
	measure 'Profit vs PP %' =
			VAR _first = MIN ( 'DateTable'[Date] )
			VAR _last = MAX ( 'DateTable'[Date] )
			VAR _months = DATEDIFF ( _first, _last, MONTH ) + 1
			VAR _prior =
			    CALCULATE (
			        [Total Profit],
			        REMOVEFILTERS ( 'DateTable' ),
			        DATESBETWEEN ( 'DateTable'[Date], EDATE ( _first, - _months ), _first - 1 )
			    )
			VAR _current = [Total Profit]
			RETURN
			    IF ( NOT ISBLANK ( _prior ), DIVIDE ( _current - _prior, _prior ) )
		formatString: \↑\ 0.00%;\↓\ 0.00%;0.00%
		displayFolder: Dashboard Design

	/// Change in Total Quantity versus the immediately preceding period of the same length (in months). Blank when no prior data exists.
	measure 'Quantity vs PP %' =
			VAR _first = MIN ( 'DateTable'[Date] )
			VAR _last = MAX ( 'DateTable'[Date] )
			VAR _months = DATEDIFF ( _first, _last, MONTH ) + 1
			VAR _prior =
			    CALCULATE (
			        [Total Quantity],
			        REMOVEFILTERS ( 'DateTable' ),
			        DATESBETWEEN ( 'DateTable'[Date], EDATE ( _first, - _months ), _first - 1 )
			    )
			VAR _current = [Total Quantity]
			RETURN
			    IF ( NOT ISBLANK ( _prior ), DIVIDE ( _current - _prior, _prior ) )
		formatString: \↑\ 0.00%;\↓\ 0.00%;0.00%
		displayFolder: Dashboard Design

	/// Change in Profit Margin versus the immediately preceding period of the same length, in percentage points. Blank when no prior data exists.
	measure 'Margin vs PP (pp)' =
			VAR _first = MIN ( 'DateTable'[Date] )
			VAR _last = MAX ( 'DateTable'[Date] )
			VAR _months = DATEDIFF ( _first, _last, MONTH ) + 1
			VAR _priorRevenue =
			    CALCULATE (
			        [Total Revenue],
			        REMOVEFILTERS ( 'DateTable' ),
			        DATESBETWEEN ( 'DateTable'[Date], EDATE ( _first, - _months ), _first - 1 )
			    )
			VAR _priorMargin =
			    CALCULATE (
			        [Profit Margin],
			        REMOVEFILTERS ( 'DateTable' ),
			        DATESBETWEEN ( 'DateTable'[Date], EDATE ( _first, - _months ), _first - 1 )
			    )
			RETURN
			    IF ( NOT ISBLANK ( _priorRevenue ), ( [Profit Margin] - _priorMargin ) * 100 )
		formatString: \↑\ 0.00\ \p\p;\↓\ 0.00\ \p\p;0.00\ \p\p
		displayFolder: Dashboard Design

	/// Font color for the revenue change label: green when up, red when down, grey when there is no prior period.
	measure 'Revenue Delta Color' =
			VAR _change = [Revenue vs PP %]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _change ), "#8A94A6", _change >= 0, "#16A34A", "#DC2626" )
		displayFolder: Dashboard Design

	/// Font color for the profit change label: green when up, red when down, grey when there is no prior period.
	measure 'Profit Delta Color' =
			VAR _change = [Profit vs PP %]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _change ), "#8A94A6", _change >= 0, "#16A34A", "#DC2626" )
		displayFolder: Dashboard Design

	/// Font color for the quantity change label: green when up, red when down, grey when there is no prior period.
	measure 'Quantity Delta Color' =
			VAR _change = [Quantity vs PP %]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _change ), "#8A94A6", _change >= 0, "#16A34A", "#DC2626" )
		displayFolder: Dashboard Design

	/// Font color for the margin change label: green when up, red when down, grey when there is no prior period.
	measure 'Margin Delta Color' =
			VAR _change = [Margin vs PP (pp)]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _change ), "#8A94A6", _change >= 0, "#16A34A", "#DC2626" )
		displayFolder: Dashboard Design

	/// First and last month of the current date selection, e.g. "Jan 2025 – Dec 2025", shown in the report header.
	measure 'Period Label' =
			VAR _first = MIN ( 'DateTable'[Date] )
			VAR _last = MAX ( 'DateTable'[Date] )
			RETURN
			    IF ( NOT ISBLANK ( _first ), FORMAT ( _first, "mmm yyyy" ) & " – " & FORMAT ( _last, "mmm yyyy" ) )
		displayFolder: Dashboard Design

	/// Key takeaway 1: total revenue and its change versus the previous period.
	measure 'Takeaway Revenue' =
			VAR _revenue = [Total Revenue]
			VAR _change = [Revenue vs PP %]
			VAR _revenueText =
			    IF (
			        _revenue >= 1e9,
			        FORMAT ( _revenue / 1e9, "0.00" ) & "B ₫",
			        FORMAT ( _revenue / 1e6, "0.00" ) & "M ₫"
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( _revenue ),
			        "Total revenue reached " & _revenueText
			            & IF (
			                ISBLANK ( _change ),
			                " across " & [Period Label] & ".",
			                ", " & IF ( _change >= 0, "up ", "down " ) & FORMAT ( ABS ( _change ), "0.00%" ) & " compared to the previous period."
			            )
			    )
		displayFolder: Dashboard Design

	/// Key takeaway 2: overall profit margin and the month with the highest margin.
	measure 'Takeaway Margin' =
			VAR _months =
			    FILTER (
			        ADDCOLUMNS (
			            SUMMARIZE ( 'DateTable', 'DateTable'[Year], 'DateTable'[Month_Number] ),
			            "@Margin", [Profit Margin],
			            "@Revenue", [Total Revenue]
			        ),
			        [@Revenue] > 0
			    )
			VAR _peak = TOPN ( 1, _months, [@Margin], DESC )
			VAR _peakMargin = MAXX ( _peak, [@Margin] )
			VAR _peakMonth = MAXX ( _peak, FORMAT ( DATE ( 'DateTable'[Year], 'DateTable'[Month_Number], 1 ), "mmmm" ) )
			RETURN
			    IF (
			        COUNTROWS ( _months ) > 0,
			        "Profit margin held around " & FORMAT ( [Profit Margin], "0.0%" )
			            & ", with a peak of " & FORMAT ( _peakMargin, "0.00%" ) & " in " & _peakMonth & "."
			    )
		displayFolder: Dashboard Design

	/// Key takeaway 3: how often revenue and profit growth moved together, and the month with the strongest revenue growth.
	measure 'Takeaway Growth' =
			VAR _months =
			    FILTER (
			        ADDCOLUMNS (
			            SUMMARIZE ( 'DateTable', 'DateTable'[Year], 'DateTable'[Month_Number] ),
			            "@RevenueGrowth", [MoM Revenue Growth],
			            "@ProfitGrowth", [MoM Profit Growth]
			        ),
			        NOT ISBLANK ( [@RevenueGrowth] ) && NOT ISBLANK ( [@ProfitGrowth] )
			    )
			VAR _monthCount = COUNTROWS ( _months )
			VAR _sameDirection = COUNTROWS ( FILTER ( _months, SIGN ( [@RevenueGrowth] ) = SIGN ( [@ProfitGrowth] ) ) )
			VAR _best = TOPN ( 1, _months, [@RevenueGrowth], DESC )
			VAR _bestGrowth = MAXX ( _best, [@RevenueGrowth] )
			VAR _bestMonth = MAXX ( _best, FORMAT ( DATE ( 'DateTable'[Year], 'DateTable'[Month_Number], 1 ), "mmmm" ) )
			RETURN
			    IF (
			        _monthCount > 0,
			        "Revenue and profit growth moved together in " & _sameDirection & " of " & _monthCount
			            & " months; revenue grew fastest in " & _bestMonth & " (" & FORMAT ( _bestGrowth, "+0.0%;-0.0%" ) & ")."
			    )
		displayFolder: Dashboard Design

	/// Upper bound for the column axis of the Category Performance chart: leaves headroom above the tallest column so the profit-margin line sits above the bars.
	measure 'Category Axis Max' =
			VAR _maxRevenue = MAXX ( VALUES ( 'ProductsTable'[Category] ), [Total Revenue] )
			RETURN
			    _maxRevenue * 1.7
		formatString: #,0
		displayFolder: Dashboard Design

	/// Upper bound for the column axis of the Bottom 5 Products chart (the five products with the lowest profit margin), with headroom for the margin line.
	measure 'Product Axis Max' =
			VAR _products =
			    FILTER ( VALUES ( 'ProductsTable'[Product_Name] ), NOT ISBLANK ( [Total Revenue] ) )
			VAR _bottom5 = TOPN ( 5, _products, [Profit Margin], ASC )
			RETURN
			    MAXX ( _bottom5, [Total Revenue] ) * 1.7
		formatString: #,0
		displayFolder: Dashboard Design

	/// Region with the highest Total Revenue in the current selection (Performance Breakdown highlight card).
	measure 'Top Region' =
			VAR _rows =
			    FILTER ( ADDCOLUMNS ( VALUES ( 'SalesTable'[Region] ), "@Revenue", [Total Revenue] ), NOT ISBLANK ( [@Revenue] ) )
			RETURN
			    MAXX ( TOPN ( 1, _rows, [@Revenue], DESC ), 'SalesTable'[Region] )
		displayFolder: Dashboard Design

	/// Share of Total Revenue earned by the top region, e.g. "55.0% of total revenue".
	measure 'Top Region Caption' =
			VAR _rows =
			    FILTER ( ADDCOLUMNS ( VALUES ( 'SalesTable'[Region] ), "@Revenue", [Total Revenue] ), NOT ISBLANK ( [@Revenue] ) )
			VAR _topRevenue = MAXX ( _rows, [@Revenue] )
			RETURN
			    IF ( NOT ISBLANK ( _topRevenue ), FORMAT ( DIVIDE ( _topRevenue, [Total Revenue] ), "0.0%" ) & " of total revenue" )
		displayFolder: Dashboard Design

	/// Sales channel with the highest Total Revenue in the current selection.
	measure 'Top Sales Channel' =
			VAR _rows =
			    FILTER ( ADDCOLUMNS ( VALUES ( 'SalesTable'[Sales_Channel] ), "@Revenue", [Total Revenue] ), NOT ISBLANK ( [@Revenue] ) )
			RETURN
			    MAXX ( TOPN ( 1, _rows, [@Revenue], DESC ), 'SalesTable'[Sales_Channel] )
		displayFolder: Dashboard Design

	/// Share of Total Revenue earned by the top sales channel.
	measure 'Top Sales Channel Caption' =
			VAR _rows =
			    FILTER ( ADDCOLUMNS ( VALUES ( 'SalesTable'[Sales_Channel] ), "@Revenue", [Total Revenue] ), NOT ISBLANK ( [@Revenue] ) )
			VAR _topRevenue = MAXX ( _rows, [@Revenue] )
			RETURN
			    IF ( NOT ISBLANK ( _topRevenue ), FORMAT ( DIVIDE ( _topRevenue, [Total Revenue] ), "0.0%" ) & " of total revenue" )
		displayFolder: Dashboard Design

	/// Product category with the highest Total Revenue in the current selection.
	measure 'Top Category' =
			VAR _rows =
			    FILTER ( ADDCOLUMNS ( VALUES ( 'ProductsTable'[Category] ), "@Revenue", [Total Revenue] ), NOT ISBLANK ( [@Revenue] ) )
			RETURN
			    MAXX ( TOPN ( 1, _rows, [@Revenue], DESC ), 'ProductsTable'[Category] )
		displayFolder: Dashboard Design

	/// Share of Total Revenue earned by the top category.
	measure 'Top Category Caption' =
			VAR _rows =
			    FILTER ( ADDCOLUMNS ( VALUES ( 'ProductsTable'[Category] ), "@Revenue", [Total Revenue] ), NOT ISBLANK ( [@Revenue] ) )
			VAR _topRevenue = MAXX ( _rows, [@Revenue] )
			RETURN
			    IF ( NOT ISBLANK ( _topRevenue ), FORMAT ( DIVIDE ( _topRevenue, [Total Revenue] ), "0.0%" ) & " of total revenue" )
		displayFolder: Dashboard Design

	/// Product category with the highest Profit Margin (categories with sales only).
	measure 'Best Margin Category' =
			VAR _rows =
			    FILTER ( ADDCOLUMNS ( VALUES ( 'ProductsTable'[Category] ), "@Margin", [Profit Margin], "@Revenue", [Total Revenue] ), [@Revenue] > 0 )
			RETURN
			    MAXX ( TOPN ( 1, _rows, [@Margin], DESC ), 'ProductsTable'[Category] )
		displayFolder: Dashboard Design

	/// Profit Margin of the best-margin category, e.g. "63.1% profit margin".
	measure 'Best Margin Category Caption' =
			VAR _rows =
			    FILTER ( ADDCOLUMNS ( VALUES ( 'ProductsTable'[Category] ), "@Margin", [Profit Margin], "@Revenue", [Total Revenue] ), [@Revenue] > 0 )
			VAR _margin = MAXX ( _rows, [@Margin] )
			RETURN
			    IF ( NOT ISBLANK ( _margin ), FORMAT ( _margin, "0.0%" ) & " profit margin" )
		displayFolder: Dashboard Design

	/// Product with the lowest Profit Margin (products with sales only).
	measure 'Lowest Margin Product' =
			VAR _rows =
			    FILTER ( ADDCOLUMNS ( VALUES ( 'ProductsTable'[Product_Name] ), "@Margin", [Profit Margin], "@Revenue", [Total Revenue] ), [@Revenue] > 0 )
			RETURN
			    MAXX ( TOPN ( 1, _rows, [@Margin], ASC ), 'ProductsTable'[Product_Name] )
		displayFolder: Dashboard Design

	/// Profit Margin of the lowest-margin product.
	measure 'Lowest Margin Product Caption' =
			VAR _rows =
			    FILTER ( ADDCOLUMNS ( VALUES ( 'ProductsTable'[Product_Name] ), "@Margin", [Profit Margin], "@Revenue", [Total Revenue] ), [@Revenue] > 0 )
			VAR _margin = MINX ( _rows, [@Margin] )
			RETURN
			    IF ( NOT ISBLANK ( _margin ), FORMAT ( _margin, "0.0%" ) & " profit margin" )
		displayFolder: Dashboard Design

