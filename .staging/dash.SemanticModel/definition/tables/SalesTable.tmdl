	partition SalesTable = m
		mode: import
		source = ```
				let
				    Source = Excel.Workbook(File.Contents("Y:\Desktop\Project_DA\Retail Dataset.xlsx"), null, true),
				    SalesTable_Table = Source{[Item="SalesTable",Kind="Table"]}[Data],
				    #"Filtered Rows" = Table.SelectRows(SalesTable_Table, each true),
				    #"Changed Type" = Table.TransformColumnTypes(#"Filtered Rows",{{"Unit_Cost", Int64.Type}, {"Discount_Pct", type number}}),
				    #"Filtered Rows1" = Table.SelectRows(#"Changed Type", each true),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Filtered Rows1",{{"Unit_Price", type number}, {"Quantity", Int64.Type}}),
				    #"Filtered Rows2" = Table.SelectRows(#"Changed Type1", each true),
				    #"Changed Type2" = Table.TransformColumnTypes(#"Filtered Rows2",{{"Gross_Sales", type number}, {"Net_Sales", type number}, {"Gross_Profit", type number}}),
				    #"Added Custom" = Table.AddColumn(#"Changed Type2", "compare", each if [Net_Sales] > [Gross_Sales] then "Check" else "OK"),
				    #"Changed Type3" = Table.TransformColumnTypes(#"Added Custom",{{"compare", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type3",{"compare"}),
				    #"Added Custom1" = Table.AddColumn(#"Removed Columns", "Custom", each 
				    if [Order_Status] = "Returned" or [Order_Status] = "Cancelled" then "Excluded"
				    else if [Discount_Pct] = 0 and [Net_Sales] = [Gross_Sales] then "OK"
				    else if [Discount_Pct] > 0 and [Net_Sales] < [Gross_Sales] then "OK"
				    else "Check"
				),
				    #"Changed Type4" = Table.TransformColumnTypes(#"Added Custom1",{{"Custom", type text}}),
				    #"Removed Columns1" = Table.RemoveColumns(#"Changed Type4",{"Custom"})
				in
				    #"Removed Columns1"
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

